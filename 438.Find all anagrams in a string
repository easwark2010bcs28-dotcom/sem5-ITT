class Solution:
    def findAnagrams(self, s: str, p: str) -> list[int]:
        if len(s) < len(p):
            return []
        p_counts = {}
        s_counts = {}
        for char in p:
            p_counts[char] = p_counts.get(char, 0) + 1
        for i in range(len(p)):
            s_counts[s[i]] = s_counts.get(s[i], 0) + 1
        result = [0] if s_counts == p_counts else []
        for i in range(len(p), len(s)):
            s_counts[s[i]] = s_counts.get(s[i], 0) + 1
            left_char = s[i - len(p)]
            if s_counts[left_char] == 1:
                del s_counts[left_char]
            else:
                s_counts[left_char] -= 1
            if s_counts == p_counts:
                result.append(i - len(p) + 1)
        return result
