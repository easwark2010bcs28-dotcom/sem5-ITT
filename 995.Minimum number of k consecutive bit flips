class Solution:
    def minKBitFlips(self, nums: list[int], k: int) -> int:
        n = len(nums)
        flipped = [0] * n
        current_flips = 0
        total_flips = 0
        for i in range(n):
            if i >= k:
                current_flips ^= flipped[i - k]
            if nums[i] ^ current_flips == 0:
                if i + k > n:
                    return -1
                flipped[i] = 1
                current_flips ^= 1
                total_flips += 1
        return total_flips

        
