class Solution:
    def checkRecord(self, n: int) -> int:
        MOD = 10**9 + 7
        dp = [[0] * 3 for _ in range(2)]
        dp[0][0] = 1   
        for _ in range(n):
            next_dp = [[0] * 3 for _ in range(2)]
            for a in range(2):
                for l in range(3):
                    if dp[a][l] == 0:
                        continue
                    next_dp[a][0] = (next_dp[a][0] + dp[a][l]) % MOD
                    if a < 1:
                        next_dp[a + 1][0] = (next_dp[a + 1][0] + dp[a][l]) % MOD
                    if l < 2:
                        next_dp[a][l + 1] = (next_dp[a][l + 1] + dp[a][l]) % MOD         
            dp = next_dp
        total_valid_records = 0
        for a in range(2):
            for l in range(3):
                total_valid_records = (total_valid_records + dp[a][l]) % MOD            
        return total_valid_records
