import heapq

class Solution:
    def medianSlidingWindow(self, nums: list[int], k: int) -> list[float]:
        small, large = [], []
        lazy = {}
        small_size, large_size = 0, 0

        def prune_heaps():
            while small and lazy.get(-small[0], 0) > 0:
                lazy[-small[0]] -= 1
                heapq.heappop(small)
            while large and lazy.get(large[0], 0) > 0:
                lazy[large[0]] -= 1
                heapq.heappop(large)

        def balance():
            nonlocal small_size, large_size
            if small_size > large_size + 1:
                heapq.heappush(large, -heapq.heappop(small))
                small_size -= 1
                large_size += 1
                prune_heaps()
            elif small_size < large_size:
                heapq.heappush(small, -heapq.heappop(large))
                large_size -= 1
                small_size += 1
                prune_heaps()

        def add(num):
            nonlocal small_size, large_size
            if not small or num <= -small[0]:
                heapq.heappush(small, -num)
                small_size += 1
            else:
                heapq.heappush(large, num)
                large_size += 1
            prune_heaps()
            balance()

        def remove(num):
            nonlocal small_size, large_size
            lazy[num] = lazy.get(num, 0) + 1
            if num <= -small[0]:
                small_size -= 1
            else:
                large_size -= 1
            prune_heaps()
            balance()

        def get_median():
            if k % 2 != 0:
                return float(-small[0])
            return (-small[0] + large[0]) / 2.0

        for i in range(k):
            add(nums[i])
            
        result = [get_median()]
        for i in range(k, len(nums)):
            add(nums[i])
            remove(nums[i - k])
            result.append(get_median())
            
        return result
